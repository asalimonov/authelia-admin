{
  "name": "svelte-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host --port 9093",
    "build": "vite build",
    "preview": "HOST=0.0.0.0 PORT=9093 node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:functional": "vitest run --config vitest.functional.config.ts",
    "lint": "eslint 'src/**/*.{ts,svelte}'",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.69.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/ldapjs": "^3.0.6",
    "@types/pg": "^8.20.0",
    "eslint": "^10.6.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "serve": "^14.2.6",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@apollo/client": "^4.2.5",
    "@inlang/paraglide-js": "^2.20.2",
    "cross-fetch": "^4.1.0",
    "encoding": "^0.1.13",
    "graphql": "^17.0.2",
    "ldapts": "^8.1.8",
    "pg": "^8.22.0",
    "sqlite3": "^6.0.1",
    "yaml": "^2.9.0"
  }
}
