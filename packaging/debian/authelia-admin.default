# Environment for the authelia-admin service, loaded by systemd.
# Restart the service after changing it: systemctl restart authelia-admin

HOST=0.0.0.0
PORT=9093
NODE_ENV=production

# Set this to 127.0.0.1 when a reverse proxy on this machine is the only client.
# HOST=127.0.0.1

# YAML configuration file
AAD_CONFIG_PATH=/etc/authelia-admin/config.yml

# The server assumes https unless ORIGIN or PROTOCOL_HEADER says otherwise.
# A browser opened at http://this-host:9093 then fails every form post, because
# its Origin is http. Set ORIGIN to the exact URL you open in the browser.
# The value is fixed here, so a client cannot spoof it.
# ORIGIN=http://127.0.0.1:9093
# ORIGIN=https://auth.example.com

# Uncomment only when a reverse proxy overwrites these headers and is the only
# client. If the port is reachable directly, a client can choose the origin.
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host

# Extra browser origins allowed to submit forms, comma-separated.
# When unset, https://auth.localhost.test is also allowed. A literal * is not
# a wildcard.
# TRUSTED_ORIGINS=https://auth.example.com

# The service runs as user authelia-admin. That user must be able to read and
# write Authelia's database: the SQLite file and its directory, or PostgreSQL.

# Optional overrides of config.yml, for example:
# AAD_AUTHELIA_DOMAIN=auth.example.com
# AAD_LOGLEVEL=INFO
# AAD_DB_TYPE=PG
