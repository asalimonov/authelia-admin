[Unit]
Description=Authelia Admin Control Panel
Documentation=https://github.com/digennarot/authelia-admin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=authelia-admin
Group=authelia-admin
WorkingDirectory=/usr/lib/authelia-admin
EnvironmentFile=/etc/default/authelia-admin
ExecStart=/usr/lib/authelia-admin/bin/node build
Restart=on-failure
RestartSec=5
StateDirectory=authelia-admin
NoNewPrivileges=yes
PrivateTmp=yes
# full keeps /usr, /boot and /etc read-only and leaves every other path writable.
# strict would block Authelia's database, which lives outside /var/lib/authelia-admin
# (for example /data or /var/lib/authelia). ProtectHome is off so a database under
# /home stays visible. The service user still needs filesystem permission on that path.
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
