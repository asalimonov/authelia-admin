#!/bin/sh
set -e

PKG=authelia-admin
STATE_DIR=/var/lib/authelia-admin

case "$1" in
	configure)
		if ! getent group "$PKG" >/dev/null; then
			addgroup --system "$PKG" >/dev/null
		fi
		if ! getent passwd "$PKG" >/dev/null; then
			adduser --system --ingroup "$PKG" --home "$STATE_DIR" --no-create-home \
				--shell /usr/sbin/nologin --disabled-login "$PKG" >/dev/null
		fi

		install -d -m 0750 -o "$PKG" -g "$PKG" "$STATE_DIR"

		# These files hold the LLDAP password, so only root and the service user may read them
		chown root:"$PKG" /etc/$PKG/config.yml /etc/default/$PKG
		chmod 0640 /etc/$PKG/config.yml /etc/default/$PKG

		if [ -d /run/systemd/system ]; then
			systemctl daemon-reload >/dev/null 2>&1 || true
			if [ -n "$2" ] && systemctl is-enabled --quiet "$PKG.service"; then
				systemctl restart "$PKG.service" || true
			fi
		fi

		if [ -z "$2" ]; then
			echo "authelia-admin installed. Edit /etc/authelia-admin/config.yml and"
			echo "/etc/default/authelia-admin, then run: systemctl enable --now authelia-admin"
		fi
		;;
esac

exit 0
